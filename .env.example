VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com
VITE_TG_BOT_USERNAME=your_bot_username

# Keep false unless the bot owner has implemented /start booking with a login_url button.
# A frontend setting alone cannot enable sign-in through the installed Telegram app.
VITE_TG_APP_LOGIN_ENABLED=false

# Optional public/invite link for the membership notice. The required group ID
# is fixed in the membership contract; this link never grants booking access.
VITE_TG_GROUP_URL=
